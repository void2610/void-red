<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>VitalRouter.MRuby</id>
    <version>2.2.0</version>
    <authors>hadashiA</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/hadashiA/VitalRouter</projectUrl>
    <description>VitalRouter extensions for mruby scriptions</description>
    <repository type="git" url="https://github.com/hadashiA/VitalRouter" commit="1a6d5eae22165cd64ae54509669dafb68d893276" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="VitalRouter" version="2.2.0" exclude="Build,Analyzers" />
        <dependency id="MRubyCS" version="0.16.0" exclude="Build,Analyzers" />
        <dependency id="MRubyCS.Serializer" version="0.16.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="VitalRouter" version="2.2.0" exclude="Build,Analyzers" />
        <dependency id="MRubyCS" version="0.16.0" exclude="Build,Analyzers" />
        <dependency id="MRubyCS.Serializer" version="0.16.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="VitalRouter" version="2.2.0" exclude="Build,Analyzers" />
        <dependency id="MRubyCS" version="0.16.0" exclude="Build,Analyzers" />
        <dependency id="MRubyCS.Serializer" version="0.16.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>